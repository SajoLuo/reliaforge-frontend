{
  "name": "reliaforge-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "The ReliaForge web control plane for lifecycle-managed operations plugins.",
  "license": "MIT",
  "author": "Sajo Luo",
  "homepage": "https://github.com/SajoLuo/reliaforge-frontend#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SajoLuo/reliaforge-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/SajoLuo/reliaforge-frontend/issues"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "check:contract": "node scripts/check-api-contract.mjs",
    "check:hygiene": "node scripts/check-open-source-hygiene.mjs .",
    "test:unit": "vitest run && node --test scripts/check-open-source-hygiene.test.mjs scripts/check-api-contract.test.mjs",
    "test:coverage": "vitest run --coverage && node --test scripts/check-open-source-hygiene.test.mjs scripts/check-api-contract.test.mjs",
    "test:e2e": "playwright test",
    "build": "tsc -b --pretty false && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "18.2.63",
    "@types/react-dom": "18.2.17",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  }
}
